# Only reviewed workshop entry points and source trees belong in this repo.
/*
!/.gitignore
!/README.md
!/START_HERE.ipynb
!/introduction.md
!/dataset-guide.md
!/lab-guide.html
!/agenda.json
!/scorecard.md
!/admin-preflight.md
!/facilitator-guide.md
!/deployment-checkpoint.md
!/teardown-guide.md
!/release-checklist.md
!/validation-results.md
!/rehearsal-record.md
!/lab-instructions/
!/coco-prompts/
!/sql/
!/starter-app/
!/reference-app/
!/checkpoints/
!/scripts/

# Local credentials, account-specific targets and tool state never ship.
.env
.env.*
*.env
*.pem
*.p8
*.key
*.p12
*.pfx
connections.toml
config.toml
credentials.json
snowflake.yml
.snowflake/
.cortex/

# Generated dependencies, caches, logs and archives stay local.
node_modules/
.next/
.venv/
__pycache__/
.pytest_cache/
.ipynb_checkpoints/
coverage/
out/
output/
dist/
*.tsbuildinfo
*.pyc
*.log
*.zip
*.bak
*.orig
*.swp
.DS_Store
